# Copy to .dev.vars for local development with `wrangler dev`.
# Cookies use the Secure attribute and the __Host- prefix. Chrome and Firefox store them on
# http://localhost, but Safari does not, so use Chrome or Firefox for local development.

# The Deploy to Cloudflare button asks for every uncommented key in this file as a secret.
# Keep only JWT_SECRET uncommented; the other settings are plain variables.

# Required. At least 32 characters. Generate one with `openssl rand -hex 32`.
# Left empty on purpose so that a placeholder is never used in production.
JWT_SECRET=

# "password" (default) or "oidc"
# AUTH_MODE=password

# Required when AUTH_MODE=oidc. In password mode, when set, it enables multi-factor authentication with passkeys
# and security keys (WebAuthn) and is used as the origin of invitation links.
# APP_ORIGIN=https://pinglune.example.com

# Required only when AUTH_MODE=oidc.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=pinglune
# OIDC_CLIENT_SECRET=dummy-secret

# For AUTH_MODE=oidc. While there are no users, the first login with this email becomes the first admin. Unset,
# nobody can log in to an empty deployment. Later users are registered by an admin on the users screen.
# INITIAL_ADMIN_EMAIL=admin@example.com

# Optional for AUTH_MODE=oidc. Set to "false" only when the IdP does not send email_verified and every
# login method of the IdP verifies emails (e.g. Cloudflare Access for SaaS with Google as the only login method).
# Users are linked to existing accounts by email, so an unverified login method could take over an account.
# When the claim is present it must still be true. Review this setting whenever OIDC_ISSUER changes.
# OIDC_REQUIRE_EMAIL_VERIFIED=false

# Optional for AUTH_MODE=oidc. Set to "true" only when the IdP is Google. The first login of an address other than
# @gmail.com then requires the hd claim (the Google Workspace domain) in the ID token: without it, Google does not
# vouch that the address still belongs to the account. Later logins of the same user are not checked.
# With Cloudflare Access as the OIDC provider, first make Access put a claim named hd into the ID token it issues:
# add hd to the OIDC claims of the Google identity provider, and add it as a custom claim of the SaaS application.
# With "true" and no such claim, nobody but @gmail.com addresses can log in for the first time.
# A value other than "true" or "false" is a mistake and rejects every first login.
# OIDC_REQUIRE_GOOGLE_HD=true

# Optional for AUTH_MODE=password. Who must use multi-factor authentication: "optional" (default), "admins" or
# "all". "admins" and "all" need APP_ORIGIN or PASSWORD_MFA_KEY.
# PASSWORD_MFA_POLICY=optional

# Optional for AUTH_MODE=password. The key that enables authenticator apps (TOTP). Generate one with
# `openssl rand -base64 32`. Changing it makes existing TOTP secrets unreadable. In production, set it as a secret.
# Keep it commented out here, so that the Deploy to Cloudflare button does not ask for it.
# PASSWORD_MFA_KEY=

# Optional. The lifetime of web sessions in hours, whole numbers from 1 to 9600. SESSION_MAX_AGE_HOURS counts from
# the login (default 720 for password, 24 for oidc). SESSION_IDLE_TIMEOUT_HOURS counts from the last refresh
# (default: none).
# SESSION_MAX_AGE_HOURS=720
# SESSION_IDLE_TIMEOUT_HOURS=

# Optional. The domain of the email intake: the apex of a Cloudflare zone (e.g. example.com) whose
# Email Routing catch-all rule sends mail to this Worker. Set it only when you use the email intake.
# Keep it commented out here, so that the Deploy to Cloudflare button does not ask for it as a secret.
# EMAIL_DOMAIN=example.com

# Optional. The sender address of the email deliveries of bots (the "email" delivery kind), e.g.
# pinglune@notify.example.com. Its domain must be onboarded to Cloudflare Email Sending (the send_email binding in
# wrangler.jsonc). Do not use an address of the email intake. Unset, the email delivery kind is shown as not set up.
# An invalid address is treated as unset and logged as a warning. Keep it commented out here, so that the Deploy to
# Cloudflare button does not ask for it as a secret.
# EMAIL_FROM=pinglune@notify.example.com

# Optional. The score (greater than 0, at most 1) at or above which the screening of events for instructions to AIs
# holds an event. Default 0.5; an invalid value is treated as 0.5. The TypeSafe API key is entered on the management
# screen (the settings of a source), not here. Keep it commented out here, so that the Deploy to Cloudflare button
# does not ask for it as a secret.
# SCREENING_THRESHOLD=0.5
